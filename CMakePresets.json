{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    { "name": "debug", "inherits": "base", "displayName": "Debug (Linux, macOS)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "inherits": "base", "displayName": "Release (Linux, macOS)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "asan", "inherits": "base", "displayName": "ASan + UBSan (Linux, macOS)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SCI_SANITIZE": "address;undefined" } },
    { "name": "tsan", "inherits": "base", "displayName": "TSan (Linux, macOS)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SCI_SANITIZE": "thread" } },
    { "name": "fuzz", "inherits": "base", "displayName": "libFuzzer + ASan + UBSan (Linux, macOS)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SCI_FUZZ": "ON" } },
    {
      "name": "cross-aarch64", "inherits": "base", "displayName": "Release for Linux ARM64 under qemu-user (container)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-base", "hidden": true, "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "windows-debug", "inherits": "windows-base", "displayName": "Debug (Windows, clang-cl)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "windows-release", "inherits": "windows-base", "displayName": "Release (Windows, clang-cl)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "windows-asan", "inherits": "windows-base", "displayName": "ASan (Windows, clang-cl)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SCI_SANITIZE": "address" } }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "cross-aarch64", "configurePreset": "cross-aarch64" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-asan", "configurePreset": "windows-asan" }
  ],
  "testPresets": [
    { "name": "test-base", "hidden": true, "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" } },
    { "name": "debug", "inherits": "test-base", "configurePreset": "debug" },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" },
    { "name": "asan", "inherits": "test-base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "test-base", "configurePreset": "tsan" },
    { "name": "cross-aarch64", "inherits": "test-base", "configurePreset": "cross-aarch64" },
    { "name": "windows-debug", "inherits": "test-base", "configurePreset": "windows-debug" },
    { "name": "windows-release", "inherits": "test-base", "configurePreset": "windows-release" },
    { "name": "windows-asan", "inherits": "test-base", "configurePreset": "windows-asan" }
  ],
  "workflowPresets": [
    { "name": "debug", "steps": [ { "type": "configure", "name": "debug" }, { "type": "build", "name": "debug" }, { "type": "test", "name": "debug" } ] },
    { "name": "release", "steps": [ { "type": "configure", "name": "release" }, { "type": "build", "name": "release" }, { "type": "test", "name": "release" } ] },
    { "name": "asan", "steps": [ { "type": "configure", "name": "asan" }, { "type": "build", "name": "asan" }, { "type": "test", "name": "asan" } ] },
    { "name": "tsan", "steps": [ { "type": "configure", "name": "tsan" }, { "type": "build", "name": "tsan" }, { "type": "test", "name": "tsan" } ] },
    { "name": "cross-aarch64", "steps": [ { "type": "configure", "name": "cross-aarch64" }, { "type": "build", "name": "cross-aarch64" }, { "type": "test", "name": "cross-aarch64" } ] },
    { "name": "windows-debug", "steps": [ { "type": "configure", "name": "windows-debug" }, { "type": "build", "name": "windows-debug" }, { "type": "test", "name": "windows-debug" } ] },
    { "name": "windows-release", "steps": [ { "type": "configure", "name": "windows-release" }, { "type": "build", "name": "windows-release" }, { "type": "test", "name": "windows-release" } ] },
    { "name": "windows-asan", "steps": [ { "type": "configure", "name": "windows-asan" }, { "type": "build", "name": "windows-asan" }, { "type": "test", "name": "windows-asan" } ] }
  ]
}
