+
+// Whether the deterministic mode is on (SIERRA_HD_TRACE is set).
+bool sierraHdDeterministic();
+// The seed of the "sci" random source (SIERRA_HD_SEED, default 0).
+uint32 sierraHdSeed();
+// The virtual clock, in milliseconds since the engine started.
+uint32 sierraHdMillis();
+// Advances the virtual clock; runs the music timer once per base tempo
+// of virtual time crossed.
+void sierraHdAdvance(uint32 milliseconds);
+// kGetTime reads the elapsed time. A read right after another one, with no
+// other kernel call between them, lets 1 ms of virtual time pass first, so
+// scripts that wait by reading the time see it pass.
+void sierraHdElapsedTimeRead();
+// The music the virtual clock drives.
+void sierraHdSetMusic(SciMusic *music, uint32 tempoMicroseconds);
+// The music driver's own work after each music timer call (milestone 7):
+// in the deterministic mode the virtual clock runs it, not the driver's
+// timer.
+void sierraHdSetDriverTimer(void (*timer)(void *), void *param);
+// One OPL register write of the AdLib driver (milestone 7), written to
+// SIERRA_HD_OPL: reg is 0x000-0x0ff for the left OPL2, 0x100-0x1ff for the
+// right one.
+void sierraHdOplWrite(int reg, int value);
+// What the SCI MIDI driver (MidiPlayer_Midi) hands to the MIDI driver
+// (milestone 7), written to SIERRA_HD_MIDI: a channel message as its status
+// and data bytes, a SysEx message as passed to MidiDriver::sysEx.
+void sierraHdMidiSend(uint32 b);
+void sierraHdMidiSysEx(const byte *msg, uint16 length);
+// Writes one kernel call to the trace.
+void sierraHdTraceKernel(const char *name, int argc, const reg_t *argv, reg_t result);
+// The next replayed event due at the current tick, if any.
+bool sierraHdNextEvent(SciEvent &event);
+// The virtual mouse position.
+Common::Point sierraHdMouse();
+void sierraHdSetMouse(const Common::Point &position);
+// The cast of a kAnimate call (milestone 5): begun when the call starts,
+// one entry per cast member in drawing order once it has drawn, and written
+// to SIERRA_HD_ACTORS with the call's trace line.
+void sierraHdCastBegin();
+void sierraHdCastEntry(reg_t object, int16 x, int16 y, int16 z, int16 priority, int view, int16 loop, int16 cel, uint16 signal);
+// The parser (milestone 6a), written to SIERRA_HD_PARSER with the trace
+// line of the kParse or kSaid call. kParse: the input and its event when it
+// starts, then either the words (after synonyms and pronouns) with the parse
+// tree (null when the grammar rejects them), or the unknown word (null when
+// the input had no words).
+void sierraHdParseBegin(const char *input, reg_t event);
+void sierraHdParseWords(const ResultWordListList &words, const ParseTreeNode *tree);
+void sierraHdParseUnknown(const char *word);
+// kSaid: the spec (null when it cannot be read), how it matched (null,
+// invalid, skipped, none, partial or full) and the event's claimed flag the
+// call leaves (-1 without an event).
+void sierraHdSaid(const byte *spec, int size, const char *outcome, int claimed);
+// The window layout (milestone 6b): whether SIERRA_HD_LAYOUT is set, and one
+// line for it, after the tick and the number of the kernel call running
+// (printf-style). A rectangle in screen coordinates, as left,top,right,bottom
+// (offset by the port's origin when a port is given), and a quoted string
+// (len bytes, or up to its end).
+bool sierraHdLayoutOn();
+void sierraHdLayout(const char *format, ...) GCC_PRINTF(1, 2);
+Common::String sierraHdRect(const Common::Rect &rect, const Port *port = nullptr);
+Common::String sierraHdQuoted(const char *text, int len = -1);
+
+} // End of namespace Sci
+
+#endif
