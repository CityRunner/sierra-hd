+// sierra-hd: in the deterministic mode the day starts at Monday 1990-01-01,
+// 12:00:00 and runs with the virtual clock.
+static void sierraHdTimeAndDate(TimeDate &timeDate) {
+	if (!sierraHdDeterministic()) {
+		g_system->getTimeAndDate(timeDate);
+		return;
+	}
+	const uint32 seconds = 12 * 60 * 60 + sierraHdMillis() / 1000;
+	const uint32 ofDay = seconds % (24 * 60 * 60);
+	const uint32 days = seconds / (24 * 60 * 60);
+	timeDate = TimeDate();
+	timeDate.tm_sec = ofDay % 60;
+	timeDate.tm_min = (ofDay / 60) % 60;
+	timeDate.tm_hour = ofDay / 3600;
+	timeDate.tm_mday = 1 + days;
+	timeDate.tm_mon = 0;
+	timeDate.tm_year = 90;
+	timeDate.tm_wday = (1 + days) % 7;
+}
