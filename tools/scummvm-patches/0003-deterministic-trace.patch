+// sierra-hd: in the deterministic mode, every kernel call is traced with
+// its arguments (as the script passed them) and its result.
+static void callKernelFunc(EngineState *s, int kernelCallNr, int argc) {
+	if (!sierraHdDeterministic()) {
+		callKernelFuncUntraced(s, kernelCallNr, argc);
+		return;
+	}
+	Kernel *kernel = g_sci->getKernel();
+	const reg_t *argv = s->xs->sp + 1;
+	Common::Array<reg_t> arguments(argv, argc);
+	const char *name = "?";
+	int first = 0;
+	if (kernelCallNr >= 0 && kernelCallNr < (int)kernel->_kernelFuncs.size()) {
+		const KernelFunction &kernelCall = kernel->_kernelFuncs[kernelCallNr];
+		name = kernelCall.name;
+		if (kernelCall.subFunctionCount && argc >= 1 && !argv[0].isPointer() &&
+			argv[0].toUint16() < kernelCall.subFunctionCount && kernelCall.subFunctions[argv[0].toUint16()].name) {
+			name = kernelCall.subFunctions[argv[0].toUint16()].name;
+			first = 1;
+		}
+	}
+	callKernelFuncUntraced(s, kernelCallNr, argc);
+	sierraHdTraceKernel(name, argc - first, arguments.data() + first, s->r_acc);
+}
