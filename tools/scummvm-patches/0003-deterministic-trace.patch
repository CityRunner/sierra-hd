+
+State &state();
+
+// The input as a quoted string: \" and \\, and \xHH for bytes outside 32 to 126.
+Common::String quoted(const char *text, int len = -1) {
+	Common::String result = "\"";
+	for (const byte *p = (const byte *)text; *p && (len < 0 || p < (const byte *)text + len); ++p) {
+		if (*p == '"' || *p == '\\')
+			result += Common::String::format("\\%c", *p);
+		else if (*p < 32 || *p > 126)
+			result += Common::String::format("\\x%02x", *p);
+		else
+			result += (char)*p;
+	}
+	return result + "\"";
+}
+
+// A parse tree node and its children (see the top of the file).
+void appendTree(Common::String &out, const ParseTreeNode *node, int depth) {
+	if (!node) {
+		out += "-";
+		return;
+	}
+	if (depth > 100) {
+		out += "?";
+		return;
+	}
+	switch (node->type) {
+	case kParseTreeLeafNode:
+		out += Common::String::format("%x", node->value);
+		break;
+	case kParseTreeWordNode:
+		out += Common::String::format("w%x", node->value);
+		if (node->right) {
+			out += "/";
+			appendTree(out, node->right, depth + 1);
+		}
+		break;
+	case kParseTreeBranchNode:
+		out += "(";
+		appendTree(out, node->left, depth + 1);
+		out += ",";
+		appendTree(out, node->right, depth + 1);
+		out += ")";
+		break;
+	default:
+		out += Common::String::format("?%d", (int)node->type);
+		break;
+	}
+}
+
+uint32 numberFrom(const char *name, uint32 fallback) {
+	const char *value = getenv(name);
+	return value ? (uint32)strtoul(value, nullptr, 10) : fallback;
+}
+
+SciEvent makeEvent(SciEventType type, uint16 character, uint16 modifiers, const Common::Point &position) {
+	SciEvent event = SciEvent();
+	event.type = type;
+	event.modifiers = (SciKeyModifiers)modifiers;
+	event.character = character;
+	event.mousePos = position;
+	return event;
+}
+
+// Reads the replay file: "sierra-hd replay 1", then one event per line.
+void readReplay(State &s, const char *path) {
+	FILE *file = fopen(path, "r");
+	if (!file)
+		error("sierra-hd: cannot read the replay file %s", path);
+	char line[1024];
+	bool header = false;
+	Common::Point position;
+	while (fgets(line, sizeof(line), file)) {
+		line[strcspn(line, "\r\n")] = 0;
+		if (!line[0] || line[0] == '#')
+			continue;
+		if (!header) {
+			if (strcmp(line, "sierra-hd replay 1") != 0)
+				error("sierra-hd: %s is not a version 1 replay file", path);
+			header = true;
+			continue;
+		}
+		unsigned long tick = 0;
+		char kind[16] = {0};
+		int consumed = 0;
+		if (sscanf(line, "%lu %15s %n", &tick, kind, &consumed) < 2)
+			error("sierra-hd: bad replay line: %s", line);
+		const char *rest = line + consumed;
+		unsigned int a = 0, b = 0, c = 0;
+		ReplayEvent replayEvent;
+		replayEvent.tick = (uint32)tick;
+		if (strcmp(kind, "text") == 0) {
+			for (const char *p = rest; *p; ++p) {
+				replayEvent.event = makeEvent(kSciEventKeyDown, (byte)*p, kSciKeyModNone, position);
+				s.replay.push_back(replayEvent);
+			}
+			replayEvent.event = makeEvent(kSciEventKeyDown, kSciKeyEnter, kSciKeyModNone, position);
+			s.replay.push_back(replayEvent);
+		} else if (strcmp(kind, "key") == 0 && sscanf(rest, "%u %u", &a, &b) >= 1) {
+			replayEvent.event = makeEvent(kSciEventKeyDown, (uint16)a, (uint16)b, position);
+			s.replay.push_back(replayEvent);
+		} else if ((strcmp(kind, "down") == 0 || strcmp(kind, "up") == 0) && sscanf(rest, "%u %u %u", &a, &b, &c) >= 2) {
+			position = Common::Point((int16)a, (int16)b);
+			replayEvent.event = makeEvent(strcmp(kind, "down") == 0 ? kSciEventMousePress : kSciEventMouseRelease, 0, (uint16)c, position);
+			s.replay.push_back(replayEvent);
+		} else if (strcmp(kind, "move") == 0 && sscanf(rest, "%u %u", &a, &b) == 2) {
+			position = Common::Point((int16)a, (int16)b);
+			replayEvent.event = makeEvent(kSciEventNone, 0, 0, position);
+			s.replay.push_back(replayEvent);
+		} else {
+			error("sierra-hd: bad replay line: %s", line);
+		}
+	}
+	fclose(file);
+}
+
+State &state() {
+	static State s;
+	if (!s.initialised) {
+		s.initialised = true;
+		const char *trace = getenv("SIERRA_HD_TRACE");
+		if (trace && *trace) {
+			s.on = true;
+			s.trace = fopen(trace, "w");
+			if (!s.trace)
+				error("sierra-hd: cannot write the trace file %s", trace);
+			s.seed = numberFrom("SIERRA_HD_SEED", 0);
+			s.stopTick = numberFrom("SIERRA_HD_STOP_TICK", 0xFFFFFFFF);
+			s.stopCalls = numberFrom("SIERRA_HD_STOP_CALLS", 0xFFFFFFFF);
+			const char *replay = getenv("SIERRA_HD_REPLAY");
+			if (replay && *replay)
+				readReplay(s, replay);
+			const char *screens = getenv("SIERRA_HD_SCREENS");
+			if (screens && *screens)
+				s.screens = screens;
+			s.screenEvery = numberFrom("SIERRA_HD_SCREEN_EVERY", 60);
+			if (s.screenEvery == 0)
+				s.screenEvery = 60;
+			const char *actors = getenv("SIERRA_HD_ACTORS");
+			if (actors && *actors) {
+				s.actors = fopen(actors, "w");
+				if (!s.actors)
+					error("sierra-hd: cannot write the actors file %s", actors);
+			}
+			const char *layout = getenv("SIERRA_HD_LAYOUT");
+			if (layout && *layout) {
+				s.layout = fopen(layout, "w");
+				if (!s.layout)
+					error("sierra-hd: cannot write the layout file %s", layout);
+			}
+			const char *opl = getenv("SIERRA_HD_OPL");
+			if (opl && *opl) {
+				s.opl = fopen(opl, "w");
+				if (!s.opl)
+					error("sierra-hd: cannot write the OPL file %s", opl);
+			}
+			const char *midi = getenv("SIERRA_HD_MIDI");
+			if (midi && *midi) {
+				s.midi = fopen(midi, "w");
+				if (!s.midi)
+					error("sierra-hd: cannot write the MIDI file %s", midi);
+			}
+			const char *parser = getenv("SIERRA_HD_PARSER");
+			if (parser && *parser) {
+				s.parser = fopen(parser, "w");
+				if (!s.parser)
+					error("sierra-hd: cannot write the parser file %s", parser);
+			}
+		}
+	}
+	return s;
+}
+
+uint32 currentTick(const State &s) {
+	return (uint32)(s.microseconds * 60 / 1000000);
+}
+
+void checkStop(State &s) {
+	if (currentTick(s) >= s.stopTick || s.calls >= s.stopCalls) {
+		if (s.trace)
+			fflush(s.trace);
+		if (s.actors)
+			fflush(s.actors);
+		if (s.parser)
+			fflush(s.parser);
+		if (s.layout)
+			fflush(s.layout);
+		if (s.opl)
+			fflush(s.opl);
+		if (s.midi)
+			fflush(s.midi);
+		g_sci->quitGame();
+	}
+	// A script that never returns to the event loop would not see the quit:
+	// a minute (of virtual time) or a million kernel calls later, the
+	// process ends, as sci-vm stops then too.
+	if ((uint64)currentTick(s) >= (uint64)s.stopTick + 3600 || (uint64)s.calls >= (uint64)s.stopCalls + 1000000) {
+		if (s.trace)
+			fclose(s.trace);
+		if (s.actors)
+			fclose(s.actors);
+		if (s.parser)
+			fclose(s.parser);
+		if (s.layout)
+			fclose(s.layout);
+		if (s.opl)
+			fclose(s.opl);
+		if (s.midi)
+			fclose(s.midi);
+		warning("sierra-hd: the game did not stop at the limit; ending the process");
+		exit(0);
+	}
+}
+
+// Writes a 1x map the logic reads (priority or control) as a binary PGM.
+void dumpMap(State &s, uint32 tick, const char *name, byte (GfxScreen::*get)(int16, int16)) {
+	GfxScreen *screen = g_sci->_gfxScreen;
+	const int16 width = screen->getScriptWidth();
+	const int16 height = screen->getScriptHeight();
+	char path[1024];
+	snprintf(path, sizeof(path), "%s/%06u.%s.pgm", s.screens, tick, name);
+	FILE *file = fopen(path, "wb");
+	if (!file)
+		error("sierra-hd: cannot write %s", path);
+	fprintf(file, "P5\n%d %d\n15\n", width, height);
+	for (int16 y = 0; y < height; ++y) {
+		for (int16 x = 0; x < width; ++x)
+			fputc((screen->*get)(x, y), file);
+	}
+	fclose(file);
+}
+
+// Writes the screen the player sees (the backend's game surface, without
+// the cursor) as a binary PPM once the tick reaches the next one due.
+void dumpScreen(State &s) {
+	const uint32 tick = currentTick(s);
+	if (!s.screens || tick < s.nextScreen || !g_sci || !g_sci->_gfxScreen)
+		return;
+	Graphics::Surface *surface = g_system->lockScreen();
+	if (!surface)
+		return;
+	if (surface->format.bytesPerPixel != 1)
+		error("sierra-hd: the screen is not 8 bits per pixel");
+	byte palette[256 * 3];
+	g_system->getPaletteManager()->grabPalette(palette, 0, 256);
+	char path[1024];
+	snprintf(path, sizeof(path), "%s/%06u.ppm", s.screens, tick);
+	FILE *file = fopen(path, "wb");
+	if (!file)
+		error("sierra-hd: cannot write %s", path);
+	fprintf(file, "P6\n%d %d\n255\n", surface->w, surface->h);
+	for (int y = 0; y < surface->h; ++y) {
+		const byte *row = (const byte *)surface->getBasePtr(0, y);
+		for (int x = 0; x < surface->w; ++x)
+			fwrite(palette + 3 * row[x], 1, 3, file);
+	}
+	fclose(file);
+	g_system->unlockScreen();
+	dumpMap(s, tick, "priority", &GfxScreen::getPriority);
+	dumpMap(s, tick, "control", &GfxScreen::getControl);
+	s.nextScreen = tick - tick % s.screenEvery + s.screenEvery;
+}
+
+void writeValue(FILE *file, reg_t value) {
+	if (value.getSegment() == 0)
+		fprintf(file, "%u", value.getOffset());
+	else
+		fprintf(file, "%x:%04x", value.getSegment(), value.getOffset());
+}
+
+} // End of anonymous namespace
+
+bool sierraHdDeterministic() {
+	return state().on;
+}
+
+uint32 sierraHdSeed() {
+	return state().seed;
+}
+
+uint32 sierraHdMillis() {
+	return (uint32)(state().microseconds / 1000);
+}
+
+void sierraHdAdvance(uint32 milliseconds) {
+	State &s = state();
+	s.microseconds += (uint64)milliseconds * 1000;
+	while (s.music && s.tempo && s.musicDue <= s.microseconds) {
+		s.musicDue += s.tempo;
+		++s.musicCalls;
+		{
+			Common::StackLock lock(s.music->_mutex);
+			s.music->onTimer();
+		}
+		if (s.driverTimer)
+			s.driverTimer(s.driverTimerParam);
+	}
+	checkStop(s);
+	dumpScreen(s);
+}
+
+void sierraHdElapsedTimeRead() {
+	State &s = state();
+	if (s.elapsedRead && s.calls == s.lastElapsedRead + 1)
+		sierraHdAdvance(1);
+	s.elapsedRead = true;
+	s.lastElapsedRead = s.calls;
+}
+
+void sierraHdSetMusic(SciMusic *music, uint32 tempoMicroseconds) {
+	State &s = state();
+	s.music = music;
+	s.tempo = tempoMicroseconds;
+	s.musicDue = s.microseconds + tempoMicroseconds;
+}
+
+void sierraHdSetDriverTimer(void (*timer)(void *), void *param) {
+	State &s = state();
+	s.driverTimer = timer;
+	s.driverTimerParam = param;
+}
+
+void sierraHdOplWrite(int reg, int value) {
+	State &s = state();
+	if (s.opl)
+		fprintf(s.opl, "%u %03x %02x\n", s.musicCalls, reg & 0x1ff, value & 0xff);
+}
+
+void sierraHdMidiSend(uint32 b) {
+	State &s = state();
+	if (!s.midi)
+		return;
+	// Two bytes for a program change or channel pressure, three otherwise.
+	const byte command = b & 0xf0;
+	if (command == 0xc0 || command == 0xd0)
+		fprintf(s.midi, "%u %02x %02x\n", s.musicCalls, b & 0xff, (b >> 8) & 0xff);
+	else
+		fprintf(s.midi, "%u %02x %02x %02x\n", s.musicCalls, b & 0xff, (b >> 8) & 0xff, (b >> 16) & 0xff);
+}
+
+void sierraHdMidiSysEx(const byte *msg, uint16 length) {
+	State &s = state();
+	if (!s.midi)
+		return;
+	fprintf(s.midi, "%u", s.musicCalls);
+	for (uint16 i = 0; i < length; ++i)
+		fprintf(s.midi, " %02x", msg[i]);
+	fputc('\n', s.midi);
+}
+
+void sierraHdTraceKernel(const char *name, int argc, const reg_t *argv, reg_t result) {
+	State &s = state();
+	if (!s.trace)
+		return;
+	fprintf(s.trace, "%u %u %s(", s.calls, currentTick(s), name);
+	for (int i = 0; i < argc; ++i) {
+		if (i)
+			fputc(',', s.trace);
+		writeValue(s.trace, argv[i]);
+	}
+	fputs(") = ", s.trace);
+	writeValue(s.trace, result);
+	fputc('\n', s.trace);
+	if (s.actors && strcmp(name, "Animate") == 0) {
+		for (uint i = 0; i < s.cast.size(); ++i) {
+			const CastEntry &entry = s.cast[i];
+			fprintf(s.actors, "%u %u ", currentTick(s), s.calls);
+			writeValue(s.actors, entry.object);
+			fprintf(s.actors, " %d %d %d %d %d %d %d %04x\n", entry.x, entry.y, entry.z, entry.priority, entry.view,
+			        entry.loop, entry.cel, entry.signal);
+		}
+		s.cast.clear();
+	}
+	if (s.parser && strcmp(name, "Parse") == 0 && !s.parse.empty()) {
+		SegManager *segMan = g_sci->getEngineState()->_segMan;
+		fprintf(s.parser, "%u %u %s type=%u claimed=%u\n", currentTick(s), s.calls, s.parse.c_str(),
+		        (unsigned)readSelectorValue(segMan, s.parseEvent, SELECTOR(type)),
+		        (unsigned)readSelectorValue(segMan, s.parseEvent, SELECTOR(claimed)));
+		s.parse.clear();
+	}
+	if (s.parser && strcmp(name, "Said") == 0 && !s.said.empty()) {
+		fprintf(s.parser, "%u %u %s\n", currentTick(s), s.calls, s.said.c_str());
+		s.said.clear();
+	}
+	++s.calls;
+	checkStop(s);
+}
+
+bool sierraHdNextEvent(SciEvent &event) {
+	State &s = state();
+	while (!s.replay.empty() && s.replay.front().tick <= currentTick(s)) {
+		event = s.replay.front().event;
+		s.replay.pop_front();
+		// Mouse events carry their position; key events the current one.
+		if (event.type == kSciEventKeyDown)
+			event.mousePos = s.mouse;
+		else
+			s.mouse = event.mousePos;
+		if (event.type != kSciEventNone)
+			return true;
+	}
+	return false;
+}
+
+Common::Point sierraHdMouse() {
+	return state().mouse;
+}
+
+void sierraHdSetMouse(const Common::Point &position) {
+	state().mouse = position;
+}
+
+void sierraHdCastBegin() {
+	state().cast.clear();
+}
+
+void sierraHdCastEntry(reg_t object, int16 x, int16 y, int16 z, int16 priority, int view, int16 loop, int16 cel, uint16 signal) {
+	CastEntry entry;
+	entry.object = object;
+	entry.x = x;
+	entry.y = y;
+	entry.z = z;
+	entry.priority = priority;
+	entry.view = view;
+	entry.loop = loop;
+	entry.cel = cel;
+	entry.signal = signal;
+	state().cast.push_back(entry);
+}
+
+void sierraHdParseBegin(const char *input, reg_t event) {
+	State &s = state();
+	if (!s.parser)
+		return;
+	s.parse = "parse " + quoted(input);
+	s.parseEvent = event;
+}
+
+void sierraHdParseWords(const ResultWordListList &words, const ParseTreeNode *tree) {
+	State &s = state();
+	if (!s.parser)
+		return;
+	s.parse += tree ? " ok words=" : " syntax words=";
+	for (ResultWordListList::const_iterator i = words.begin(); i != words.end(); ++i) {
+		if (i != words.begin())
+			s.parse += ",";
+		for (ResultWordList::const_iterator j = i->begin(); j != i->end(); ++j) {
+			if (j != i->begin())
+				s.parse += "|";
+			s.parse += Common::String::format("%03x:%03x", j->_class, j->_group);
+		}
+	}
+	if (tree) {
+		s.parse += " tree=";
+		appendTree(s.parse, tree, 0);
+	}
+}
+
+void sierraHdParseUnknown(const char *word) {
+	State &s = state();
+	if (!s.parser)
+		return;
+	if (word)
+		s.parse += " unknown word=" + quoted(word);
+	else
+		s.parse += " empty";
+}
+
+void sierraHdSaid(const byte *spec, int size, const char *outcome, int claimed) {
+	State &s = state();
+	if (!s.parser)
+		return;
+	s.said = "said ";
+	if (!spec) {
+		s.said += "-";
+	} else {
+		for (int i = 0; i < size; ++i) {
+			s.said += Common::String::format("%02x", spec[i]);
+			if (spec[i] == 0xff)
+				break;
+		}
+	}
+	s.said += Common::String::format(" %s claimed=", outcome);
+	s.said += claimed < 0 ? Common::String("-") : Common::String::format("%d", claimed);
+}
+
+bool sierraHdLayoutOn() {
+	return state().layout != nullptr;
+}
+
+void sierraHdLayout(const char *format, ...) {
+	State &s = state();
+	if (!s.layout)
+		return;
+	fprintf(s.layout, "%u %u ", currentTick(s), s.calls);
+	va_list arguments;
+	va_start(arguments, format);
+	vfprintf(s.layout, format, arguments);
+	va_end(arguments);
+	fputc('\n', s.layout);
+}
+
+Common::String sierraHdRect(const Common::Rect &rect, const Port *port) {
+	const int16 left = port ? port->left : 0;
+	const int16 top = port ? port->top : 0;
+	return Common::String::format("%d,%d,%d,%d", rect.left + left, rect.top + top, rect.right + left, rect.bottom + top);
+}
+
+Common::String sierraHdQuoted(const char *text, int len) {
+	return quoted(text ? text : "", len);
+}
+
+} // End of namespace Sci
