diff -ruN a/engines/sci/resource/sierra_hd_dump.cpp b/engines/sci/resource/sierra_hd_dump.cpp
--- a/engines/sci/resource/sierra_hd_dump.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/engines/sci/resource/sierra_hd_dump.cpp	2026-10-20 18:13:40.256738211 +0000
@@ -0,0 +1,79 @@
+/* sierra-hd reference tooling for ScummVM's SCI engine.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * Dumps every resource as ScummVM's resource manager loads it, so that the
+ * sierra-hd resource loader can be compared with it byte for byte. Output:
+ *
+ *   <dir>/<type>.<number>   the resource data, without patch headers
+ *   <dir>/manifest.txt      one line per resource, sorted by type and number:
+ *                           <type> <number> <size> <loaded type>.<loaded number> <source>
+ *                           or <type> <number> FAILED
+ *
+ * <loaded type/number> is the id after loading, which the volume header can
+ * override; <source> is the file name the data came from.
+ */
+
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "common/algorithm.h"
+#include "common/array.h"
+
+#include "sci/resource/resource.h"
+#include "sci/resource/resource_intern.h"
+
+namespace Sci {
+
+const char *ResourceManager::sierraHdDumpDirectory() {
+	return getenv("SIERRA_HD_DUMP_RESOURCES");
+}
+
+void ResourceManager::sierraHdDumpResourcesAndExit() {
+	const char *directory = sierraHdDumpDirectory();
+	Common::Array<ResourceId> ids;
+	for (int type = 0; type < kResourceTypeInvalid; ++type) {
+		Common::List<ResourceId> list = listResources((ResourceType)type);
+		for (Common::List<ResourceId>::const_iterator it = list.begin(); it != list.end(); ++it)
+			ids.push_back(*it);
+	}
+	Common::sort(ids.begin(), ids.end());
+
+	Common::String manifestPath = Common::String::format("%s/manifest.txt", directory);
+	FILE *manifest = fopen(manifestPath.c_str(), "w");
+	if (!manifest)
+		exit(1);
+
+	bool ok = true;
+	for (uint i = 0; i < ids.size(); ++i) {
+		const ResourceId &id = ids[i];
+		const char *typeName = getResourceTypeName(id.getType());
+		Resource *res = findResource(id, false);
+		if (!res) {
+			fprintf(manifest, "%s %u FAILED\n", typeName, id.getNumber());
+			continue;
+		}
+
+		Common::String dataPath = Common::String::format("%s/%s.%03u", directory, typeName, id.getNumber());
+		FILE *data = fopen(dataPath.c_str(), "wb");
+		if (!data || (res->size() > 0 && fwrite(res->data(), 1, res->size(), data) != res->size()))
+			ok = false;
+		if (data)
+			fclose(data);
+
+		fprintf(manifest, "%s %u %u %s.%u %s\n", typeName, id.getNumber(), res->size(),
+		        getResourceTypeName(res->getType()), res->getNumber(),
+		        res->getResourceLocation().baseName().c_str());
+	}
+
+	if (fclose(manifest) != 0)
+		ok = false;
+	exit(ok ? 0 : 1);
+}
+
+} // End of namespace Sci
diff -ruN a/engines/sci/sci.cpp b/engines/sci/sci.cpp
--- a/engines/sci/sci.cpp	2026-10-20 18:10:44.662892151 +0000
+++ b/engines/sci/sci.cpp	2026-10-20 18:13:40.254903181 +0000
@@ -280,6 +280,12 @@
 	_resMan->addAppropriateSources();
 	_resMan->init();
 
+	// sierra-hd reference tooling: dump all resources and exit the process.
+	// Returning from run() here would crash in ~SciEngine, which expects a
+	// fully initialised engine.
+	if (ResourceManager::sierraHdDumpDirectory())
+		_resMan->sierraHdDumpResourcesAndExit();
+
